{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "src/lib/graphqlRequest.js", "app/blog/index.tsx", "app/post/[slug]", "src/api/contact.js", "app/api/contact/route.js", "components/date.js", "components/ShuffleHero.tsx", "components/Portfolio.tsx", "app/portfolio/page.jsx", "components/NavLink.jsx", "components/myComponents/ErrorMessage.js"],
  "exclude": ["node_modules"]
}